# Copier ce fichier en .env et remplir les valeurs
SECRET_KEY=            # obligatoire en production (python -c "import secrets;print(secrets.token_urlsafe(50))")
DEBUG=False
ALLOWED_HOSTS=exemple.com,www.exemple.com
SITE_URL=https://exemple.com

# HTTPS derrière Nginx
USE_HTTPS=True
USE_PROXY_HEADERS=True

# Base de données (SQLite par défaut) et cache partagé (recommandé en production)
# DATABASE_URL=postgres://user:pass@localhost:5432/techshop
# REDIS_URL=redis://127.0.0.1:6379/1

# Email (Gmail : mot de passe d'application)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Paiement en ligne CinetPay (vide = paiement à la livraison uniquement)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# Front React : laisser vide si le front et l'API sont sur le même domaine (cas par défaut avec Nginx)
# FRONTEND_URL=https://exemple.com
# CSRF_TRUSTED_ORIGINS=https://exemple.com
