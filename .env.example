# ════════════════════════════════════════════════════════════════════
#  Copier ce fichier en .env et remplir les valeurs
#  Logique base de données :
#    DEBUG=True  + pas de DATABASE_URL  → SQLite  (dev local)
#    DEBUG=False + DATABASE_URL défini  → PostgreSQL (production)
#    DATABASE_URL défini (peu importe DEBUG) → PostgreSQL forcé
# ════════════════════════════════════════════════════════════════════

# ── Django ──────────────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGER_MOI

# true = SQLite local | false = PostgreSQL obligatoire via DATABASE_URL
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# URL publique de l'app (pour les retours de paiement CinetPay, etc.)
SITE_URL=http://localhost:8000

# ── Base de données ──────────────────────────────────────────────────
# Laisser vide en dev (SQLite automatique si DEBUG=True)
# En production (DEBUG=False) : obligatoire
# DATABASE_URL=postgres://techshop:motdepasse@localhost:5432/techshop

# ── Redis (optionnel — LocMemCache utilisé si absent) ────────────────
# REDIS_URL=redis://127.0.0.1:6379/1

# ── HTTPS / Proxy (Nginx / Coolify) ──────────────────────────────────
USE_HTTPS=False
USE_PROXY_HEADERS=False

# ── CSRF (liste de domaines séparés par des virgules) ─────────────────
# CSRF_TRUSTED_ORIGINS=https://votre-domaine.com

# ── Email (Gmail — mot de passe d'application) ───────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── CinetPay (paiement en ligne — laisser vide si non utilisé) ───────
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
